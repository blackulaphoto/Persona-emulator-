# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/personas_db
# For local SQLite testing: sqlite:///./personas.db

# OpenAI
OPENAI_API_KEY=sk-your-api-key-here

# Security
JWT_SECRET=your-secret-key-change-in-production

# Environment
ENVIRONMENT=development
DEBUG=True

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# --- Firebase Authentication (backend/app/core/auth.py) ---
# Required in any deployed environment. Provide ONE of the following two:

# Option A: the full service account JSON as a single-line env var (preferred
# for hosting platforms - Railway, Render, etc.). Get this from Firebase
# Console > Project Settings > Service Accounts > Generate new private key.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...", ...}

# Option B: a service account JSON file at backend/firebase-service-account.json
# (gitignored - never commit this file). Used automatically if
# FIREBASE_SERVICE_ACCOUNT_JSON is not set.

# --- Local/CI only: Firebase Auth Emulator ---
# Set BOTH to run the backend against a local Firebase Auth Emulator
# (`npx firebase-tools emulators:start --only auth --project demo-rubicks`)
# instead of a real Firebase project. No real credentials needed in this
# mode. NEVER set these in a deployed environment.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# GCLOUD_PROJECT=demo-rubicks

# --- Local-dev-only auth bypass ---
# Only takes effect when Firebase is genuinely unconfigured above AND
# ENVIRONMENT is not "production". Treats every request as a single fake
# local user - never enable this in a deployed environment.
# AUTH_DEV_BYPASS=true
