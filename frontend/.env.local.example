# Backend API URL (REQUIRED)
# For Railway deployment, set this to your Railway backend URL
# Example: https://your-service-name.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase Configuration (REQUIRED for authentication)
# From Firebase Console > Project Settings > General > Your apps > Web app.
# These are the public client config values - safe to expose to the
# browser (Firebase security comes from your Firebase Security Rules /
# Authentication settings, not from hiding these). Do not put a service
# account or any backend secret here.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# --- Local/CI only: Firebase Auth Emulator ---
# Set to run the frontend against a local Firebase Auth Emulator
# (`npx firebase-tools emulators:start --only auth --project demo-rubicks`)
# instead of a real Firebase project - no real Firebase config needed above
# in this mode. Only takes effect in a non-production build. NEVER set this
# in a deployed environment.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Local-dev-only auth bypass ---
# Only takes effect when Firebase is genuinely unconfigured above (no
# NEXT_PUBLIC_FIREBASE_* values and no emulator host) AND this is not a
# production build. Signs everyone in as a single fake local user with no
# real Firebase token - never enable this in a deployed environment.
# NEXT_PUBLIC_AUTH_DEV_BYPASS=true
