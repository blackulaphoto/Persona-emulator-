
# Python
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/
backend/venv/
backend/env/

# Environment variables
.env
.env.local
backend/.env
frontend/.env.local

# Database files
*.db
backend/app.db
backend/dev.db

# Firebase
backend/firebase-service-account.json
backend/firebase/
firebase-debug.log
firebase-export-*/
.firebase/
ui-debug.log

# Narrative folder
Narrative/
# ...but not the real Rubix Narrative route this rule was accidentally also
# catching (Windows filesystems are case-insensitive, so "Narrative/" above
# matches frontend/app/persona/[id]/narrative/ too) - carved out narrowly,
# same pattern as the splash/ exception below, rather than touching whatever
# the original rule exists to protect elsewhere.
!frontend/app/persona/\[id\]/narrative/
!frontend/app/persona/\[id\]/narrative/**

# OS and IDE
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# Build and temp files
nul
backend/nul

# Ignore splash/ globally, but allow frontend splash assets for deployment
splash/
!frontend/public/splash/
!frontend/public/splash/**

# Claude settings (local only)
.claude/settings.local.json
